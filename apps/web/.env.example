# -------------------------------
# Application Environment
# -------------------------------

# Note: Next.js automatically sets NODE_ENV based on `next dev` (development) or `next build` (production). Do not set NODE_ENV in this file manually.

# Server Port
PORT=3000


# -------------------------------
# Strapi Integration        
# -------------------------------

# Public URL of your Strapi backend instance
STRAPI_URL="http://127.0.0.1:1337"

# API Token (Read Only Access) generated from the Strapi Admin panel
STRAPI_TOKEN="your_strapi_api_token_here"


# -------------------------------
# Media Configuration
# -------------------------------

# Public URL used to access uploaded media files
PUBLIC_MEDIA_URL="http://127.0.0.1:9000"


# -------------------------------
# Webhook & Cache Invalidation
# -------------------------------

# Secret token used to validate on-demand ISR revalidation requests from Strapi
REVALIDATE_SECRET="your_revalidate_secret_token"


# -------------------------------
# Supabase Configuration
# -------------------------------

# Publicly exposed Supabase project URL and Anonymous API key
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON="your_supabase_anon_public_key"


# -------------------------------
# Setup
# -------------------------------
# 1. Create a Supabase project and set:
#      NEXT_PUBLIC_SUPABASE_URL
#      NEXT_PUBLIC_SUPABASE_ANON
#
# 2. Create Google and GitHub OAuth apps.
#    In Supabase > Authentication > Sign In / Providers:
#      - Add the Google and GitHub client IDs/secrets.
#      - Use the callback URL provided by Supabase.
#      - Enable both providers.
#
# 3. Import the demo data into Strapi:
#      cd apps/cms
#      pnpm strapi import -f strapi-demo-data.tar.gz
#
# 4. In Strapi Admin > Settings > API Tokens:
#      - Copy an existing read-only token to STRAPI_TOKEN.
#      - If none exists, create one with read-only permissions.
#
# 5. Generate a secure secret and set REVALIDATE_SECRET:
#      openssl rand -base64 32
#
# 6. In Strapi, create a webhook for the frontend revalidation endpoint:
#      URL: https://your-frontend-url/api/revalidate
#      Header: x-revalidate-secret: <REVALIDATE_SECRET>
#      Events: Entry, Media
#
# 7. Strapi must be reachable before building the Next.js app because
#    the web app fetches data from Strapi during `next build`.
#    Deploy Strapi first, set STRAPI_URL to its deployed URL, then
#    build and deploy the web app.