# -------------------------------
# Environment Configuration
# -------------------------------

# Execution environment (development, staging, production)
NODE_ENV="development"


# -------------------------------
# Server Configuration
# -------------------------------

# Network interface Strapi listens on
HOST="0.0.0.0"

# Port Strapi listens on
PORT=1337

# Public URL used to access the Strapi instance
PUBLIC_URL="http://localhost:1337"


# -------------------------------
# Security & Cryptography
# -------------------------------

# Comma-separated list of application keys (base64 encoded strings recommended)
APP_KEYS="your_base64_key_1,your_base64_key_2,your_base64_key_3,your_base64_key_4"

# Salting and signing tokens (base64 encoded strings recommended)
API_TOKEN_SALT="your_api_token_salt_here"
ADMIN_JWT_SECRET="your_admin_jwt_secret_here"
TRANSFER_TOKEN_SALT="your_transfer_token_salt_here"
ENCRYPTION_KEY="your_encryption_key_here"
JWT_SECRET="your_jwt_secret_here"


# -------------------------------
# Database Configuration
# -------------------------------

# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@host:port/database_name"


# -------------------------------
# S3-Compatible Object Storage
# -------------------------------

STORAGE_ACCESS_KEY_ID="your_storage_access_key_id"
STORAGE_SECRET_ACCESS_KEY="your_storage_secret_access_key"
STORAGE_ENDPOINT="http://127.0.0.1:9000"
STORAGE_REGION="your-storage-region"
STORAGE_BUCKET="your-bucket-name"
STORAGE_PUBLIC_ACCESS_URL="http://127.0.0.1:9000"

# Optional: set to true if your S3-compatible provider requires path-style URLs,
# such as local MinIO. Defaults to false when omitted.
STORAGE_FORCE_PATH_STYLE="false"


# -------------------------------
# Data Transfer & Migrations
# -------------------------------

# Optional: used only when running Strapi data transfer or migration commands
# from the local environment. These variables aren't required at runtime.
STRAPI_TRANSFER_URL="https://your-remote-strapi-instance.com/admin"
STRAPI_TRANSFER_TOKEN="your_transfer_token_here"


# -------------------------------
# Email (SMTP)
# -------------------------------

# SMTP server configuration
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password"

# Default addressing
DEFAULT_FROM="no-reply@example.com"
DEFAULT_REPLY_TO="support@example.com"